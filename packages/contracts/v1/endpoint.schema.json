{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/endpoint.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "endpoint_config": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "destination": {
      "type": "string",
      "pattern": "^http://[a-z][a-z0-9_-]*:[0-9]{2,5}(?![\\s\\S])"
    },
    "expected_image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "state": {
      "enum": [
        "enabled",
        "suspended",
        "revoked"
      ]
    },
    "allowed_methods": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
      },
      "maxItems": 100
    },
    "api_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)(?![\\s\\S])"
    },
    "timeout_ms": {
      "type": "integer",
      "minimum": 100,
      "maximum": 30000
    },
    "payload_limit_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    },
    "health_path": {
      "const": "/health"
    },
    "public_key_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "issuer_key_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "audience": {
      "const": "mp-document-stats-v1"
    },
    "issuer": {
      "const": "modular-platform-host-v1"
    }
  },
  "required": [
    "schema_version",
    "endpoint_config",
    "installation_id",
    "site_id",
    "workspace_id",
    "destination",
    "expected_image_digest",
    "generation",
    "state",
    "allowed_methods",
    "api_version",
    "timeout_ms",
    "payload_limit_bytes",
    "health_path",
    "public_key_ref",
    "issuer_key_ref",
    "audience",
    "issuer"
  ],
  "additionalProperties": false
}
