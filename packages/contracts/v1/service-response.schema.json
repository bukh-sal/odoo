{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/service-response.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "data": {},
        "api_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "data",
        "api_version",
        "request_id"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "enum": [
                "UNAUTHENTICATED",
                "FORBIDDEN",
                "NOT_FOUND",
                "VALIDATION_FAILED",
                "CONFLICT",
                "DEPENDENCY_UNAVAILABLE",
                "PLUGIN_SUSPENDED",
                "RATE_LIMITED",
                "DEADLINE_EXCEEDED",
                "CANCELLED",
                "INTERNAL_ERROR"
              ]
            },
            "message": {
              "type": "string",
              "maxLength": 300
            },
            "request_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
                },
                "operation_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
                },
                "outcome": {
                  "enum": [
                    "not_started",
                    "committed",
                    "unknown"
                  ]
                }
              },
              "required": [],
              "additionalProperties": false
            }
          },
          "required": [
            "code",
            "message",
            "request_id",
            "retryable",
            "details"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "error"
      ],
      "additionalProperties": false
    }
  ]
}
