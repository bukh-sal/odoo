{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/operations-request.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "prepare"
        },
        "operation_type": {
          "enum": [
            "install",
            "upgrade",
            "suspend",
            "enable",
            "uninstall",
            "unregister",
            "remove"
          ]
        },
        "plugin_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){2,}(?![\\s\\S])",
          "maxLength": 180
        },
        "site_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "workspace_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
          },
          "maxItems": 1000,
          "minItems": 0,
          "uniqueItems": true
        },
        "artifact_version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?![\\s\\S])"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "cascade": {
          "type": "boolean"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "operation_type",
        "plugin_id",
        "site_id",
        "workspace_ids",
        "cascade"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation_type": {
                "enum": [
                  "install",
                  "upgrade"
                ]
              }
            }
          },
          "then": {
            "required": [
              "artifact_version",
              "artifact_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation_type": {
                "enum": [
                  "suspend",
                  "enable",
                  "install"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "workspace_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type": {
                "enum": [
                  "uninstall",
                  "unregister",
                  "remove"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "workspace_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type": {
                "const": "remove"
              }
            }
          },
          "then": {
            "required": [
              "artifact_digest"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "operation_type": {
                "enum": [
                  "suspend",
                  "enable",
                  "uninstall",
                  "unregister"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "artifact_version"
                  ]
                },
                {
                  "required": [
                    "artifact_digest"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type": {
                "const": "remove"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "artifact_version"
              ]
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "operation": {
          "const": "request"
        },
        "operation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "plan_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}(?![\\s\\S])"
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "schema_version",
        "operation",
        "operation_id",
        "plan_hash",
        "request_id"
      ],
      "additionalProperties": false
    }
  ]
}
