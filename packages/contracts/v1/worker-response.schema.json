{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/worker-response.schema.json",
  "type": "object",
  "properties": {
    "api_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "data": {
      "type": "object",
      "properties": {
        "characters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "words": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "lines": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "characters",
        "words",
        "lines"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "api_version",
    "request_id",
    "operation_id",
    "data"
  ],
  "additionalProperties": false
}
