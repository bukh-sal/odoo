            }
          },
          "then": {
            "properties": {
              "error_code": {
                "const": "NOT_CURATED"
              },
              "validation_scope": {
                "const": "trust_gate"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "invalid"
              }
            }
          },
          "then": {
            "properties": {
              "error_code": {
                "enum": [
