        "profile_observed_at",
        "stale",
        "control_authority",
        "kind",
        "artifact_digest",
        "size",
        "result",
        "validation_scope",
        "artifact",
        "error_code",
        "retained",
        "executed"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
