{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/route.schema.json",
  "type": "object",
  "properties": {
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){2,}(?![\\s\\S])",
      "maxLength": 180
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "maxLength": 200
    },
    "params": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "query": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    }
  },
  "required": [
    "plugin_id",
    "page_id",
    "path",
    "params",
    "query"
  ],
  "additionalProperties": false
}
