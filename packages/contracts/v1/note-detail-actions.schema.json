{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "note_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "note_id",
    "expected_revision"
  ],
  "additionalProperties": false,
  "description": "Public context for Notes detail_actions major1. Trusted compiled handler receives host plus this immutable DTO; no native record/environment."
}
