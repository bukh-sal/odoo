{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/host-context.schema.json",
  "type": "object",
  "properties": {
    "ui_api_major": {
      "const": 1
    },
    "principal_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "site_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_]*){2,}$",
      "maxLength": 180
    },
    "installation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "direction": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "policy_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.]+:[a-z][a-z0-9_.]+$",
        "maxLength": 240
      },
      "maxItems": 100
    }
  },
  "required": [
    "ui_api_major",
    "principal_id",
    "display_name",
    "site_id",
    "workspace_id",
    "plugin_id",
    "installation_id",
    "locale",
    "direction",
    "timezone",
    "generation",
    "policy_generation",
    "capabilities"
  ],
  "additionalProperties": false
}
