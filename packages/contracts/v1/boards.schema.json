{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "get_input": {
      "type": "object",
      "properties": {
        "board_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "save_input": {
      "type": "object",
      "properties": {
        "board_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "lane": {
                "enum": [
                  "inbox",
                  "doing",
                  "done"
                ]
              },
              "note_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "text",
              "lane",
              "note_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 40,
          "uniqueItems": true
        }
      },
      "required": [
        "board_id",
        "expected_revision",
        "name",
        "cards"
      ],
      "additionalProperties": false
    },
    "board": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "cards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "lane": {
                "enum": [
                  "inbox",
                  "doing",
                  "done"
                ]
              },
              "note_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "text",
              "lane",
              "note_id"
            ],
            "additionalProperties": false
          },
          "maxItems": 40,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "cards"
      ],
      "additionalProperties": false
    }
  },
  "description": "Boards major1. At most40 cards, unique card IDs enforced semantically; explicit workspace selected separately, note references must resolve in that workspace. Array order is card order. Omitted board_id selects the single reference board in the explicitly selected workspace; an explicit unknown ID is not found. This never selects a workspace."
}
