{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/service-request.schema.json",
  "type": "object",
  "properties": {
    "api_version": {
      "type": "string",
      "pattern": "^[1-9][0-9]*\\.(0|[1-9][0-9]*)$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input": {
      "type": "object"
    }
  },
  "required": [
    "api_version",
    "request_id",
    "input"
  ],
  "additionalProperties": false
}
