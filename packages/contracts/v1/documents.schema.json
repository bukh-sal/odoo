{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://modularplatform.invalid/contracts/v1/documents.schema.json",
  "$defs": {
    "list_input": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            },
            {
              "type": "null"
            }
          ]
        },
        "query": {
          "type": "string",
          "maxLength": 200
        },
        "order": {
          "enum": [
            "updated_desc",
            "title_asc"
          ]
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false
    },
    "get_input": {
      "type": "object",
      "properties": {
        "note_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        }
      },
      "required": [
        "note_id"
      ],
      "additionalProperties": false
    },
    "create_input": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "title",
        "body"
      ],
      "additionalProperties": false
    },
    "update_input": {
      "type": "object",
      "properties": {
        "note_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "note_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "delete_input": {
      "type": "object",
      "properties": {
        "note_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "note_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "note": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "body": {
          "type": "string",
          "maxLength": 20000
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 30,
          "uniqueItems": true
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "body",
        "revision",
        "labels",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "labels_input": {
      "type": "object",
      "properties": {
        "note_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])"
        },
        "expected_revision": {
          "type": "integer",
          "minimum": 1
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxItems": 30,
          "uniqueItems": true
        }
      },
      "required": [
        "note_id",
        "expected_revision",
        "labels"
      ],
      "additionalProperties": false
    }
  },
  "description": "Major 1 Notes method schemas. Extension labels uses a declared separate method/permission and slot contract; create/update cannot accept extension fields implicitly."
}
