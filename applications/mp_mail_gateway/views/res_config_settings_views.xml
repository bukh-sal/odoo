<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">settings.mail.gateway</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="mail.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="emails" position="inside">
                <setting id="incoming_mailbox_settings" string="Incoming mailbox polling">
                    <button name="%(mp_mail_gateway.action_email_server_tree)d" type="action" string="Incoming Email Servers" class="btn-link"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
