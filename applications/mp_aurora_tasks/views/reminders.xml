<odoo>
    <record id="notification_view_list" model="ir.ui.view">
        <field name="name">mp.aurora.notification.list</field>
        <field name="model">mp.aurora.notification</field>
        <field name="arch" type="xml">
            <list create="0" delete="0" decoration-muted="is_read">
                <field name="title"/>
                <field name="due_date"/>
                <field name="create_date" string="Received"/>
                <field name="is_read"/>
            </list>
        </field>
    </record>
    <record id="notification_view_form" model="ir.ui.view">
        <field name="name">mp.aurora.notification.form</field>
        <field name="model">mp.aurora.notification</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header><button name="action_open_task" type="object" string="Open task"/></header>
                <sheet><group>
                    <field name="title"/>
                    <field name="due_date"/>
                    <field name="create_date" string="Received"/>
                    <field name="is_read"/>
                </group></sheet>
            </form>
        </field>
    </record>
    <record id="action_reminders" model="ir.actions.act_window">
        <field name="name">My Reminders</field>
        <field name="res_model">mp.aurora.notification</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_reminders" name="My Reminders" parent="menu_aurora" action="action_reminders" sequence="40"/>
</odoo>
