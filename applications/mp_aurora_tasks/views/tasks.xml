<odoo>
    <record id="task_list_view_list" model="ir.ui.view">
        <field name="name">mp.aurora.task.list.list</field>
        <field name="model">mp.aurora.task.list</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="owner_id"/>
                <field name="member_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>
    <record id="task_list_view_form" model="ir.ui.view">
        <field name="name">mp.aurora.task.list.form</field>
        <field name="model">mp.aurora.task.list</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="owner_id"/>
                        <field name="member_ids" widget="many2many_tags" readonly="owner_id and owner_id != uid"/>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="stage_view_list" model="ir.ui.view">
        <field name="name">mp.aurora.task.stage.list</field>
        <field name="model">mp.aurora.task.stage</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="list_id"/>
                <field name="sequence"/>
                <field name="done"/>
            </list>
        </field>
    </record>
    <record id="stage_view_form" model="ir.ui.view">
        <field name="name">mp.aurora.task.stage.form</field>
        <field name="model">mp.aurora.task.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="list_id" readonly="id" options="{'no_create': True}"/>
                        <field name="sequence"/>
                        <field name="done"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="task_view_list" model="ir.ui.view">
        <field name="name">mp.aurora.task.list</field>
        <field name="model">mp.aurora.task</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="list_id"/>
                <field name="stage_id"/>
                <field name="assignee_id"/>
                <field name="due_date"/>
                <field name="completed"/>
                <field name="reminder_status"/>
            </list>
        </field>
    </record>
    <record id="task_view_form" model="ir.ui.view">
        <field name="name">mp.aurora.task.form</field>
        <field name="model">mp.aurora.task</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete" type="object" string="Complete" invisible="completed"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="not completed"/>
                    <field name="completed" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="list_id" readonly="id" options="{'no_create': True}"/>
                        <field name="stage_id" options="{'no_create': True}"/>
                        <field name="creator_id"/>
                        <field name="assignee_id" options="{'no_create': True}"/>
                        <field name="due_date"/>
                        <field name="reminder"/>
                        <field name="reminder_at" invisible="reminder == 'none'"/>
                        <field name="reminder_status"/>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_task_lists" model="ir.actions.act_window">
        <field name="name">Task Lists</field>
        <field name="res_model">mp.aurora.task.list</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_task_stages" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">mp.aurora.task.stage</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_tasks" model="ir.actions.act_window">
        <field name="name">Tasks</field>
        <field name="res_model">mp.aurora.task</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_aurora" name="Aurora Tasks" groups="base.group_user"/>
    <menuitem id="menu_tasks" name="Tasks" parent="menu_aurora" action="action_tasks" sequence="10"/>
    <menuitem id="menu_task_lists" name="Task Lists" parent="menu_aurora" action="action_task_lists" sequence="20"/>
    <menuitem id="menu_task_stages" name="Stages" parent="menu_aurora" action="action_task_stages" sequence="30"/>
</odoo>
