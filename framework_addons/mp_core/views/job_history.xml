<odoo>
    <record id="view_job_history_list" model="ir.ui.view">
        <field name="name">mp.job.history.list</field>
        <field name="model">mp.job.history</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" import="0" export_xlsx="0" limit="50" count_limit="10000">
                <field name="public_id"/>
                <field name="state"/>
                <field name="status_at"/>
                <field name="archived"/>
            </list>
        </field>
    </record>
    <record id="view_job_history_search" model="ir.ui.view">
        <field name="name">mp.job.history.search</field>
        <field name="model">mp.job.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="public_id"/>
                <filter name="needs_attention" string="Needs attention" domain="[('state', 'in', ['dead_letter', 'held', 'outcome_unknown'])]"/>
                <separator/>
                <filter name="archived" string="Archived" domain="[('archived', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="action_job_history" model="ir.actions.act_window">
        <field name="name">My background jobs</field>
        <field name="res_model">mp.job.history</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_job_history_list"/>
        <field name="search_view_id" ref="view_job_history_search"/>
        <field name="limit">50</field>
    </record>
</odoo>
