<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="web.interface.AppLayout">
    <div class="mp-page mp-app-layout mp-interface-layout" t-att-class="props.className + (props.showContext and state.contextOpen ? ' is-context-open' : '') + (!props.showContext ? ' is-context-free' : '') + (contextCollapsed ? ' is-context-collapsed' : '') + (!toolbarTarget and props.showContext ? ' has-local-context-toolbar' : '')">
      <t t-if="props.showContext"><t t-if="toolbarTarget" t-portal="toolbarTarget"><t t-call="web.interface.AppContextToggle"/></t><t t-else=""><t t-call="web.interface.AppContextToggle"/></t></t>
      <aside t-if="props.showContext" t-att-id="contextId" class="mp-app-sidebar" t-ref="context" tabindex="-1"
             t-att-aria-labelledby="contextId + '-heading'" t-att-inert="contextCollapsed ? '' : undefined" t-on-keydown="onContextKeydown" t-on-click="onContextSelection">
        <h2 class="mp-app-context-title" t-att-id="contextId + '-heading'" t-esc="props.contextTitle"/>
        <t t-slot="context"/>
      </aside>
      <main class="mp-app-content" t-ref="content" tabindex="-1" t-att-aria-label="contentLabel"><t t-slot="default"/></main>
    </div>
  </t>
  <t t-name="web.interface.AppContextToggle">
    <button class="mp-context-toggle mp-app-context-toggle" t-ref="trigger" t-on-click="toggleContext"
            t-att-aria-controls="contextId" t-att-aria-expanded="contextExpanded ? 'true' : 'false'" t-att-aria-label="toggleLabel" t-att-title="toggleLabel">
      <Icon name="contextExpanded ? 'panel-left-close' : 'panel-left-open'" directional="true"/><span t-esc="props.contextTitle"/>
    </button>
  </t>
</templates>
