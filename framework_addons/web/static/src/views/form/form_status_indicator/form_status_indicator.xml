<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.FormStatusIndicator">
        <div class="o_form_status_indicator mp-form-status d-print-none" t-ref="statusRoot" t-att-class="{ o_form_status_indicator_new_record: props.model.root.isNew, 'is-invalid': indicatorMode === 'invalid' }" t-att-aria-busy="state.pending ? 'true' : 'false'">
            <span class="mp-form-save-state" t-ref="statusLabel" role="status" aria-live="polite" tabindex="-1" t-esc="status"/>
            <div class="o_form_status_indicator_buttons d-flex gap-2" t-att-class="{ 'd-none': !displayButtons }">
                <button
                    type="button"
                    class="o_form_button_save btn btn-primary"
                    data-hotkey="s"
                    t-on-click.stop="save"
                    t-ref="save"
                    t-att-disabled="!!state.pending or (!props.model.root.isNew and indicatorMode === 'invalid')">
                    Save changes
                </button>
                <button
                    type="button"
                    class="o_form_button_cancel btn btn-secondary"
                    data-hotkey="j"
                    t-on-click.stop="discard"
                    t-att-disabled="!!state.pending">
                    Discard
                </button>
            </div>
        </div>
    </t>
</templates>
