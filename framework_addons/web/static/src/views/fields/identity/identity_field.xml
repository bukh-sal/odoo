<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web.IdentityField">
        <div t-if="props.readonly" class="mp-identity-cell">
            <span class="mp-identity-glyph" aria-hidden="true" t-esc="initials"/>
            <span class="mp-identity-text">
                <span class="mp-identity-name" t-esc="value"/>
                <span t-if="secondary" class="mp-identity-secondary" t-esc="secondary"/>
            </span>
        </div>
        <CharField t-else="" t-props="charProps"/>
    </t>
</templates>
