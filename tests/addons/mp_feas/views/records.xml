<odoo>
    <record id="record_list" model="ir.ui.view">
        <field name="name">mp.feas.record.list</field>
        <field name="model">mp.feas.record</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="amount"/><field name="peer_id"/></list>
        </field>
    </record>
    <record id="record_form" model="ir.ui.view">
        <field name="name">mp.feas.record.form</field>
        <field name="model">mp.feas.record</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="amount"/><field name="peer_id"/><field name="peer_ids" widget="many2many_tags"/></group></sheet></form>
        </field>
    </record>
    <record id="action_records" model="ir.actions.act_window">
        <field name="name">Workspace feasibility</field>
        <field name="res_model">mp.feas.record</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_feasibility" name="Workspace feasibility" action="action_records"/>
</odoo>
