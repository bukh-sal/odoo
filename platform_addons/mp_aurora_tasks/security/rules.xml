<odoo>
    <record id="list_participants" model="ir.rule">
        <field name="name">Task lists by participation</field>
        <field name="model_id" ref="model_mp_aurora_task_list"/>
        <field name="domain_force">['|', ('owner_id', '=', user.id), ('member_ids', 'in', [user.id])]</field>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="list_delete_owner" model="ir.rule">
        <field name="name">Task list deletion by owner</field>
        <field name="model_id" ref="model_mp_aurora_task_list"/>
        <field name="domain_force">[('owner_id', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="stage_participants" model="ir.rule">
        <field name="name">Stages by list participation</field>
        <field name="model_id" ref="model_mp_aurora_task_stage"/>
        <field name="domain_force">['|', ('list_id.owner_id', '=', user.id), ('list_id.member_ids', 'in', [user.id])]</field>
    </record>
    <record id="task_participants" model="ir.rule">
        <field name="name">Tasks by list participation or assignment</field>
        <field name="model_id" ref="model_mp_aurora_task"/>
        <field name="domain_force">['|', '|', '|', ('list_id.owner_id', '=', user.id), ('list_id.member_ids', 'in', [user.id]), ('creator_id', '=', user.id), ('assignee_id', '=', user.id)]</field>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="task_create_participants" model="ir.rule">
        <field name="name">Create tasks in accessible lists</field>
        <field name="model_id" ref="model_mp_aurora_task"/>
        <field name="domain_force">['|', ('list_id.owner_id', '=', user.id), ('list_id.member_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
