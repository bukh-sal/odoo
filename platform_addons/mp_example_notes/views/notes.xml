<odoo>
    <record id="view_notes_list" model="ir.ui.view"><field name="name">mp.example.note.list</field><field name="model">mp.example.note</field><field name="arch" type="xml">
        <list><field name="title"/><field name="revision"/><field name="write_date"/></list>
    </field></record>
    <record id="view_note_form" model="ir.ui.view"><field name="name">mp.example.note.form</field><field name="model">mp.example.note</field><field name="arch" type="xml">
        <form><sheet><group><field name="title"/><field name="revision" readonly="1"/></group><group><field name="body" string="Note" placeholder="Write a note…"/></group></sheet></form>
    </field></record>
    <record id="action_notes" model="ir.actions.act_window"><field name="name">Notes</field><field name="res_model">mp.example.note</field><field name="view_mode">list,form</field></record>
</odoo>
