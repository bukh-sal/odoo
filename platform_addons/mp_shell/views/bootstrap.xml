<odoo><template id="bootstrap"><t t-call="web.layout">
    <t t-set="title">Modular Platform</t>
    <t t-set="html_data" t-value="{'lang': 'en-US', 'dir': 'ltr'}"/>
    <t t-set="head">
        <meta name="viewport" content="width=device-width, initial-scale=1"/>
        <script type="text/javascript">
            odoo.__session_info__ = <t t-out="json.dumps(session_info)"/>;
            odoo.__mp_client_release__ = <t t-out="json.dumps(mp_client_release)"/>;
            odoo.reloadMenus = () => fetch('/web/webclient/load_menus', {cache:'no-store'}).then(r => r.json());
            odoo.loadMenusPromise = odoo.reloadMenus();
        </script>
        <t t-call-assets="mp_shell.assets_host"/>
    </t>
    <t t-set="body_classname" t-value="'o_web_client mp_shell'"/>
</t></template></odoo>
